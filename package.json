{
  "name": "browser-space",
  "version": "0.11.2",
  "productName": "Browser Space",
  "description": "A multi-account browser session manager. Switch between isolated Gmail, Slack, and web accounts with named workspaces.",
  "main": "./out/main/index.js",
  "author": "kaishuu0123",
  "license": "MIT",
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome lint .",
    "biome:check": "biome check .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "electron-vite preview -- --no-sandbox",
    "dev": "electron-vite dev -- --no-sandbox",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "pnpm run build && electron-builder --win --publish never",
    "build:mac": "pnpm run build && electron-builder --mac --publish never",
    "build:linux": "electron-vite build && electron-builder --linux AppImage snap --publish=never"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/preload": "3.0.2",
    "@electron-toolkit/utils": "4.0.0",
    "@vscode/codicons": "^0.0.44",
    "class-variance-authority": "^0.7.1",
    "electron-context-menu": "^5.1.0",
    "electron-store": "^12.0.0",
    "electron-updater": "6.8.9",
    "lucide-react": "^1.65.0",
    "radix-ui": "^1.8.1",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "electron": "^45.1.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "globals": "^17.13.0",
    "postcss": "^8.4.49",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "packageManager": "pnpm@11.2.2",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.2.2",
      "onFail": "warn"
    }
  }
}
